		}
		{
			Id = "DashlessBonus"
			DisplayName = "Steady Reflex"
			Description = "Deal additionnal damage and gain more defense {#PreviousFormat}when you don't {#BoldFormatGraft}Dash {#PreviousFormat} for 4 Sec, {#TooltipUpgradeFormat}{$TempTextData.BaseValue:P} {#PreviousFormat} per rank."
    	}
		{
			Id = "CountAmmoBonus"
