		}
		{
			Id = "CompleteGarden"
			DisplayName = "Persephone's Garden"
			Description = "The son of the god of the dead shall make certain attempts to aid our Mother Night, who through course of time has grown far apart from Hecate, her parent and origin of all things."
		}
		{
			Id = "HecateCrops"
