			Description = "Enter {$Keywords.GardenGatePlural} without losing {!Icons.Health_Small}. Blessings from {#BoldFormat}Hecate {#PreviousFormat}have {#UpgradeFormat}{$TooltipData.TooltipBonusChance:P} {#PreviousFormat} chance to be {#RareFormat}Rare {#PreviousFormat}or better."
