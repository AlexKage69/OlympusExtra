			Description = "Gain {#AltUpgradeFormat}{!Icons.HealthUp_Small}{#PreviousFormat} when you collect {!Icons.GemSmall}, {#TooltipUpgradeFormat}{$TempTextData.BaseValue}% {#PreviousFormat} of the collected amount per rank. Limit of 15 {#AltUpgradeFormat}{!Icons.HealthUp_Small}{#PreviousFormat} from {!Icons.GemSmall}"
    	}
		{
			Id = "ExtraChanceFloor"
			DisplayName = "Infernal Defiance"
			Description = "Restore {#TooltipBoldFormat}40%{!Icons.Health_Small} {#PreviousFormat}instead of dying when your Life Total is depleted, {#TooltipUpgradeFormat}1 {#PreviousFormat}time {#ItalicFormat}per floor."
    	}
		{
			Id = "ExtraChanceAlt2"
